    {"type":"text","id":"commit_evidence_text","x":98,"y":745,"wi示例产品h":795,"height":142,"text":"成功事务中的真实持久化合同\n\nUPDATE session WHERE current_state_version = base_state_version\n  → vN + 1，conversation_busy = false\nINSERT checkpoint { state_version, last_committed_turn_id, state_json, source_prefix_hash }\nUPDATE conversation_turn → committed\n\n同一外层 db.commit：answer + query/trace + job event + checkpoint","originalText":"成功事务中的真实持久化合同\n\nUPDATE session WHERE current_state_version = base_state_version\n  → vN + 1，conversation_busy = false\nINSERT checkpoint { state_version, last_committed_turn_id, state_json, source_prefix_hash }\nUPDATE conversation_turn → committed\n\n同一外层 db.commit：answer + query/trace + job event + checkpoint","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWi示例产品h":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":303002,"version":2,"versionNonce":304002,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"commit_evidence","lineHeight":1.25},
